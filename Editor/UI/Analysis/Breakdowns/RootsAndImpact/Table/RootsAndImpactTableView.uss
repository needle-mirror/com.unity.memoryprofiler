/*
 * RootsAndImpactTableView.uss
 * Styles specific to the Roots & Impact table view.
 * Imports common table view styles from TableViewBase.uss
 */

@import url("../../Shared/TableViewBase.uss");

/* Extend base theme classes if necessary */
.table-view-base__dark:root
{
}

.table-view-base__light:root
{
}

/* Toolbar styles */
#roots-and-impact-table-view__toolbar
{
    border-top-width: 1px;
    height: 32px;
    padding-right: 12px;
    overflow: hidden;
}

#roots-and-impact-table-view__toolbar Toggle
{
    padding-left: 12px;
}

#roots-and-impact-table-view__toolbar Toggle .unity-toggle__text
{
    padding-left: 4px;
}

/* De-emphasis for ancestor nodes that don't match a status filter */
.roots-and-impact-table-view__filter-match-ancestor
{
    opacity: 0.5;
}

/* Page-flipping control for the flattened view; hidden until the controller shows it (flat mode, >1 page).
   The generic .memory-profiler-pager* visuals live in the shared TableViewBase.uss. */
.roots-and-impact-table-view__pager
{
    display: none;
}

/* Dual size cell: the filter-relevant value (primary, normally styled) followed by the row's own
   precalculated value (secondary), struck through via rich text and dimmed here. The primary never
   shrinks, so squishing the column truncates the secondary first, keeping the filter-relevant value. */
.dual-size-cell
{
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    overflow: hidden;
    padding-left: 6px;
    padding-right: 1px;
}

.dual-size-cell__primary
{
    flex-shrink: 0;
}

.dual-size-cell__secondary
{
    flex-shrink: 1;
    margin-left: 4px;
    overflow: hidden;
    text-overflow: ellipsis;
    color: rgba(136, 136, 136, 1);
}
