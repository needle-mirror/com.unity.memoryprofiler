<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" editor-extension-mode="True">
    <Style src="StatusFilterButton.uss"/>
    <engine:Toggle name="status-filter-button__enable-toggle" class="status-filter-button__enable-toggle"/>
    <engine:Button label="" name="status-filter-button__dropdown-button" class="table-view__filter-button status-filter-button__dropdown-button">
        <engine:Label name="status-filter-button__dropdown-label" class="table-view__filter-button-label"/>
        <engine:VisualElement class="unity-base-popup-field__arrow"/>
    </engine:Button>
</engine:UXML>
